{
  "name": "pginfo-backend",
  "version": "1.0.0",
  "description": "PGinfo.online API Server",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "start:prod": "node server.js",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:reload": "pm2 reload ecosystem.config.cjs --env production",
    "pm2:logs": "pm2 logs pginfo-backend",
    "backfill:property-cities": "node src/scripts/backfillPropertyCityIds.js",
    "backfill:property-cities:apply": "node src/scripts/backfillPropertyCityIds.js --apply",
    "migration:01:cities": "node src/scripts/migrations/01_seed_all_cities.js --apply",
    "migration:02:locations": "node src/scripts/migrations/02_normalize_property_locations.js --apply",
    "migration:03:coordinates": "node src/scripts/migrations/03_fix_null_island_coordinates.js --apply",
    "migration:04:slugs": "node src/scripts/migrations/04_backfill_slugs_audit_and_users.js --apply",
    "migration:05:indexes": "node src/scripts/migrations/05_optimize_property_indexes.js --apply",
    "migration:all": "node src/scripts/migrations/01_seed_all_cities.js --apply && node src/scripts/migrations/02_normalize_property_locations.js --apply && node src/scripts/migrations/03_fix_null_island_coordinates.js --apply && node src/scripts/migrations/04_backfill_slugs_audit_and_users.js --apply && node src/scripts/migrations/05_optimize_property_indexes.js --apply",
    "seed": "node src/scripts/seed.js",
    "export:pune": "node src/scripts/exportCityPgData.js --city=Pune",
    "export:city": "node src/scripts/exportCityPgData.js",
    "test": "node test/management_removed.test.js",
    "test:redis": "node test/redis_upstash.test.js"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "expo-server-sdk": "^7.1.0",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "node-cron": "^4.6.0",
    "resend": "^6.14.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "keywords": [
    "pg",
    "paying-guest",
    "booking",
    "real-estate"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "PGinfo.online",
  "license": "MIT"
}

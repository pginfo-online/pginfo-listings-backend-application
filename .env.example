# ==============================================================================
# PGinfo.online Backend - Production Environment Configuration Template
# ==============================================================================
# Duplicate this file to .env and configure values before starting the application.
# NEVER commit the actual .env file to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & INFRASTRUCTURE
# ------------------------------------------------------------------------------
PORT=5001
NODE_ENV=production

# AWS ALB / Nginx Reverse Proxy: 1 for single proxy hop, or true / loopback
TRUST_PROXY=1

# Process Clustering & PM2 Configuration
# Set to 'max' to utilize all CPU cores, or specify number (e.g. 2 for t3.small)
PM2_INSTANCES=max

# Schedulers (Background cron jobs for notifications and exports)
# In cluster mode, schedulers automatically run only on instance 0. Set to false to disable entirely.
ENABLE_SCHEDULERS=true

# API Rate Limiting (Requests per 15-minute window per IP)
RATE_LIMIT_MAX=1000

# ------------------------------------------------------------------------------
# 2. DATABASE (MongoDB Atlas / Amazon DocumentDB)
# ------------------------------------------------------------------------------
# Production connection string with SSL and replica set
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# MongoDB Connection Pool Settings for AWS
MONGO_MAX_POOL_SIZE=25
MONGO_MIN_POOL_SIZE=5
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_CONNECT_MAX_RETRIES=5

# DNS Fallback: Set to true so Ubuntu/EC2/Docker resolves mongodb+srv SRV DNS lookups reliably.
USE_FALLBACK_DNS=true

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Minimum 32-64 characters random string: openssl rand -base64 48
JWT_SECRET=replace_with_a_secure_random_64_character_secret_key_in_production
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. CORS CONFIGURATION
# ------------------------------------------------------------------------------
# Comma-separated allowed frontend origins without trailing slashes.
# In production, specify exact domains (e.g. https://pginfo.online,https://admin.pginfo.online)
CLIENT_URL=https://www.pginfo.in,https://pginfo.online,https://www.pginfo.online,https://admin.pginfo.online

# ------------------------------------------------------------------------------
# 5. CLOUDINARY (Media Storage: Images, Videos, Scheduled Export Reports)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 6. EMAIL OTP & TRANSACTIONAL MAILS (Resend)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=notifications@pginfo.online

# ------------------------------------------------------------------------------
# 7. REDIS (Upstash Redis TLS for Caching)
# ------------------------------------------------------------------------------
# Upstash Redis TCP/TLS Connection URL (rediss:// with port 6379)
REDIS_URL=rediss://default:<UPSTASH_PASSWORD>@<UPSTASH_ENDPOINT>:6379
REDIS_DB=0
REDIS_KEY_PREFIX=pgm:

# ------------------------------------------------------------------------------
# 8. SMS & WHATSAPP SERVICES (Meta Cloud API & Ping4SMS)
# ------------------------------------------------------------------------------
# Meta WhatsApp Cloud API for login OTP
META_WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token
META_WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
META_WHATSAPP_TEMPLATE_NAME=pginfo_login_otp
META_WHATSAPP_TEMPLATE_LANG=en_US

# SMS Gateway (Dreamz Technology)
SMS_BASE_URL=http://trans.dreamztechnolgy.org/smsstatuswithid.aspx
SMS_USER_MOBILE=your_sms_user_mobile
SMS_PASSWORD=your_sms_password
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=PGINF
SMS_PEID=1701176380063580392
SMS_TEMPLATE_ID=1777179144400581962

# Ping4SMS Gateway (Legacy / WhatsApp Fallback)
PING4SMS_BASE_URL=https://api.ping4sms.com
PING4SMS_API_KEY=your_ping4sms_api_key
PING4SMS_SENDER_ID=PNGOTP
PING4SMS_SMS_ROUTE=2
PING4SMS_DLT_TEMPLATE_ID=1507165967974501361

# Ping4SMS WhatsApp (Alternative)
PING4SMS_WHATSAPP_SENDER_ID=PNGOTP
PING4SMS_WHATSAPP_ROUTE=6
PING4SMS_WHATSAPP_TEMPLATE_ID=your_ping4sms_whatsapp_template_id

# ------------------------------------------------------------------------------
# 9. GOOGLE MAPS & GEOCODING API
# ------------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=your_google_maps_platform_api_key

# ------------------------------------------------------------------------------
# 10. MOBILE PUSH NOTIFICATIONS (Expo Push SDK)
# ------------------------------------------------------------------------------
EXPO_ACCESS_TOKEN=your_expo_access_token
NOTIFICATION_RETRY_MAX=3
NOTIFICATION_BATCH_SIZE=100

# ------------------------------------------------------------------------------
# 11. APP STORE REVIEW (TEMPORARY - Can disable or remove after App Store approval)
# ------------------------------------------------------------------------------
# Set to false to disable bypass immediately without code changes
APP_REVIEW_ENABLED=true
# 10-digit Indian test phone number provided in App Store Connect
APP_REVIEW_PHONE=9999900001
# 4-digit fixed OTP provided in App Store Connect
APP_REVIEW_OTP=1234

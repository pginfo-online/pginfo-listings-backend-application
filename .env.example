# ==============================================================================
# PGinfo Listings Backend - Production Environment Configuration Template
# Domain: https://api.pginfo.business
# ==============================================================================
# Duplicate this file to .env and configure values before starting the application.
# NEVER commit the actual .env file to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & INFRASTRUCTURE
# ------------------------------------------------------------------------------
# Choose a port that is free on your VPS (e.g. 5001, 5005, 5050)
PORT=5001
NODE_ENV=production

# Reverse Proxy Hops: 1 for Nginx reverse proxy
TRUST_PROXY=1

# PM2 Cluster Workers: Set to 'max' to use all CPU cores, or specify number (e.g. 2 for 2 vCPUs)
PM2_INSTANCES=max

# Schedulers (Background cron jobs for notifications and exports)
# In cluster mode, schedulers automatically run only on instance 0. Set to false to disable entirely.
ENABLE_SCHEDULERS=true

# API Rate Limiting (Requests per 15-minute window per IP)
RATE_LIMIT_MAX=1000

# ------------------------------------------------------------------------------
# 2. DATABASE (MongoDB Atlas / Self-hosted MongoDB)
# ------------------------------------------------------------------------------
# Production connection string with SSL and replica set
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# MongoDB Connection Pool Settings
MONGO_MAX_POOL_SIZE=25
MONGO_MIN_POOL_SIZE=5
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_CONNECT_MAX_RETRIES=5

# DNS Fallback: Set to true so Ubuntu/VPS resolves mongodb+srv SRV DNS lookups reliably.
USE_FALLBACK_DNS=true

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Minimum 32-64 characters random string: generate via: openssl rand -base64 48
JWT_SECRET=replace_with_a_secure_random_64_character_secret_key_in_production
JWT_EXPIRES_IN=7d
JWT_ACCESS_EXPIRES_IN=1h

# ------------------------------------------------------------------------------
# 4. CORS CONFIGURATION
# ------------------------------------------------------------------------------
# Comma-separated allowed frontend origins without trailing slashes.
CLIENT_URL=https://pginfo.business,https://www.pginfo.business,https://admin.pginfo.business,https://api.pginfo.business,https://www.pginfo.in,https://pginfo.in

# ------------------------------------------------------------------------------
# 5. REDIS (Caching & Session Store) - MULTIPLE MODES SUPPORTED
# ------------------------------------------------------------------------------
# OPTION A - No Redis Credentials:
# Leave REDIS_URL empty or set REDIS_ENABLED=false.
# The backend will automatically operate in resilient mode with built-in in-memory fallback.
# REDIS_URL=

# OPTION B - Local Redis installed on VPS (Recommended for single VPS):
# Install via: sudo apt install redis-server
# REDIS_URL=redis://127.0.0.1:6379
# If password protected in /etc/redis/redis.conf:
# REDIS_URL=redis://:your_redis_password@127.0.0.1:6379

# OPTION C - External Managed Redis (Upstash, AWS ElastiCache, Redis Cloud):
# REDIS_URL=rediss://default:your_cache_password@your-endpoint.upstash.io:6379

REDIS_URL=
REDIS_DB=0
REDIS_KEY_PREFIX=pgm:
REDIS_TIMEOUT_MS=2500

# ------------------------------------------------------------------------------
# 6. CLOUDINARY (Media Storage: Property Images, Room Photos, Documents)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 7. EMAIL OTP & TRANSACTIONAL MAILS (Resend)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=notifications@pginfo.business

# ------------------------------------------------------------------------------
# 8. SMS & WHATSAPP SERVICES (Meta Cloud API & Ping4SMS)
# ------------------------------------------------------------------------------
# Meta WhatsApp Cloud API for login OTP
META_WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token
META_WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
META_WHATSAPP_TEMPLATE_NAME=pginfo_login_otp
META_WHATSAPP_TEMPLATE_LANG=en_US

# SMS Gateway (Dreamz Technology)
SMS_BASE_URL=http://trans.dreamztechnolgy.org/smsstatuswithid.aspx
SMS_USER_MOBILE=your_sms_user_mobile
SMS_PASSWORD=your_sms_password
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=PGINF
SMS_PEID=1701176380063580392
SMS_TEMPLATE_ID=1777179144400581962

# Ping4SMS Gateway (Legacy / WhatsApp Fallback)
PING4SMS_BASE_URL=https://api.ping4sms.com
PING4SMS_API_KEY=your_ping4sms_api_key
PING4SMS_SENDER_ID=PNGOTP
PING4SMS_SMS_ROUTE=2
PING4SMS_DLT_TEMPLATE_ID=1507165967974501361

# Ping4SMS WhatsApp (Alternative)
PING4SMS_WHATSAPP_SENDER_ID=PNGOTP
PING4SMS_WHATSAPP_ROUTE=6
PING4SMS_WHATSAPP_TEMPLATE_ID=your_ping4sms_whatsapp_template_id

# ------------------------------------------------------------------------------
# 9. GOOGLE MAPS & GEOCODING API
# ------------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=your_google_maps_platform_api_key

# ------------------------------------------------------------------------------
# 10. MOBILE PUSH NOTIFICATIONS (Expo Push SDK)
# ------------------------------------------------------------------------------
EXPO_ACCESS_TOKEN=your_expo_access_token
NOTIFICATION_RETRY_MAX=3
NOTIFICATION_BATCH_SIZE=100

# ------------------------------------------------------------------------------
# 11. APP STORE / PLAY STORE REVIEW BYPASS (Optional)
# ------------------------------------------------------------------------------
APP_REVIEW_ENABLED=false
APP_REVIEW_PHONE=9999900001
APP_REVIEW_OTP=1234

# ------------------------------------------------------------------------------
# 12. DATABASE MIGRATION & RUNTIME FLAGS
# ------------------------------------------------------------------------------
MONGO_AUTO_INDEX=false
MONGO_AUTO_CREATE=false

# Enable daily inbox alerts for saved property searches
ENABLE_SAVED_SEARCH_ALERTS=false

# Rental Payments (Razorpay)
ENABLE_RENTAL_PAYMENTS=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ==============================================================================
# Nginx Reverse Proxy Configuration for PGinfo Listings Backend
# Domain: api.pginfo.business
# Port:   5001 (or custom PORT from .env)
# ==============================================================================
# File Location: /etc/nginx/sites-available/api.pginfo.business
# Symlink:       sudo ln -s /etc/nginx/sites-available/api.pginfo.business /etc/nginx/sites-enabled/
# Test syntax:   sudo nginx -t
# Reload Nginx:  sudo systemctl reload nginx
# ==============================================================================

# Dedicated upstream with a unique name to prevent collisions with other VPS apps
upstream pginfo_listings_backend_upstream {
    server 127.0.0.1:5001;
    keepalive 64;
}

# ------------------------------------------------------------------------------
# STEP 1: INITIAL HTTP-ONLY CONFIGURATION (Use this FIRST before running Certbot)
# ------------------------------------------------------------------------------
# server {
#     listen 80;
#     listen [::]:80;
#     server_name api.pginfo.business;
#
#     location /.well-known/acme-challenge/ {
#         root /var/www/certbot;
#     }
#
#     location / {
#         proxy_pass http://pginfo_listings_backend_upstream;
#         proxy_http_version 1.1;
#         proxy_set_header Host $host;
#         proxy_set_header X-Real-IP $remote_addr;
#         proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#         proxy_set_header X-Forwarded-Proto $scheme;
#     }
# }

# ------------------------------------------------------------------------------
# STEP 2: FULL PRODUCTION HTTPS CONFIGURATION (Active after SSL certificate is issued)
# ------------------------------------------------------------------------------

# HTTP Server - Redirect all HTTP traffic to HTTPS (with Let's Encrypt challenge support)
server {
    listen 80;
    listen [::]:80;
    server_name api.pginfo.business;

    # Let's Encrypt ACME challenge location (supports existing VPS certbot webroot)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri /var/www/pginfo-acme/$uri =404;
    }

    # Redirect all HTTP requests to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS Server
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.pginfo.business;

    # SSL Certificates (Managed by Certbot)
    ssl_certificate /etc/letsencrypt/live/api.pginfo.business/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.pginfo.business/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/api.pginfo.business/chain.pem;

    # SSL Hardening (A+ Rating on SSL Labs)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL_PGINFO:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_stapling on;
    ssl_stapling_verify on;

    # Security Headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    # Maximum file upload size (supporting large images & videos for Cloudinary)
    client_max_body_size 50M;
    client_body_buffer_size 128k;

    # Proxy timeouts for long queries, image uploads, and background tasks
    proxy_connect_timeout 60s;
    proxy_send_timeout 120s;
    proxy_read_timeout 120s;
    send_timeout 120s;

    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # Isolated application logs (does not mix with other VPS sites)
    access_log /var/log/nginx/api.pginfo.business.access.log;
    error_log /var/log/nginx/api.pginfo.business.error.log warn;

    # Health Check endpoints (no access logging to save disk I/O)
    location /health {
        proxy_pass http://pginfo_listings_backend_upstream/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        access_log off;
    }

    # Main Reverse Proxy Location
    location / {
        proxy_pass http://pginfo_listings_backend_upstream;
        proxy_http_version 1.1;

        # WebSocket & connection upgrade headers
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_cache_bypass $http_upgrade;

        # Client IP Forwarding for Rate Limiting, Audit Trails, and Analytics
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        # Proxy buffer tuning
        proxy_buffering on;
        proxy_buffer_size 16k;
        proxy_buffers 8 32k;
        proxy_busy_buffers_size 64k;
    }
}

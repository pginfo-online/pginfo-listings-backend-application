# ==============================================================================
# Nginx Reverse Proxy Configuration for PGinfo.online Backend (AWS EC2)
# ==============================================================================
# Location: /etc/nginx/sites-available/pginfo-backend
# Symlink:  sudo ln -s /etc/nginx/sites-available/pginfo-backend /etc/nginx/sites-enabled/
# Test:     sudo nginx -t
# Reload:   sudo systemctl reload nginx
# ==============================================================================

# Upstream Node.js server managed by PM2
upstream nodejs_backend {
    server 127.0.0.1:5001;
    keepalive 64;
}

# HTTP Server - Redirect all HTTP traffic to HTTPS (Certbot will manage SSL block)
server {
    listen 80;
    listen [::]:80;
    server_name api.pginfo.online; # Replace with your production domain / subdomain

    # Let's Encrypt ACME challenge location
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Redirect all HTTP requests to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS Server
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.pginfo.online; # Replace with your production domain / subdomain

    # SSL Certificates (Managed by Certbot)
    ssl_certificate /etc/letsencrypt/live/api.pginfo.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.pginfo.online/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/api.pginfo.online/chain.pem;

    # SSL Hardening (A+ Rating on SSL Labs)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_stapling on;
    ssl_stapling_verify on;

    # Security Headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    # Maximum file upload size (supporting large images & videos for Cloudinary)
    client_max_body_size 50M;
    client_body_buffer_size 128k;

    # Timeouts for long AI chat completions and report generation
    proxy_connect_timeout 60s;
    proxy_send_timeout 120s;
    proxy_read_timeout 120s;
    send_timeout 120s;

    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # Logging
    access_log /var/log/nginx/pginfo_backend_access.log;
    error_log /var/log/nginx/pginfo_backend_error.log warn;

    # AWS ALB / Route53 / Uptime Health Check endpoint (no access logging to save disk I/O)
    location /health {
        proxy_pass http://nodejs_backend/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        access_log off;
    }

    # Main Reverse Proxy Location
    location / {
        proxy_pass http://nodejs_backend;
        proxy_http_version 1.1;

        # Connection headers
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;

        # Client IP Forwarding for Rate Limiting & Audit Trails
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        # Buffering settings
        proxy_buffering on;
        proxy_buffer_size 16k;
        proxy_buffers 8 32k;
        proxy_busy_buffers_size 64k;
    }
}
